---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
export const prerender = false;

const allPosts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = allPosts.slice(0, 5);
const total = allPosts.length;

function pad(n: number, w = 2) {
  return n.toString().padStart(w, "0");
}
function fmtDate(d: Date) {
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}
function size(s: string) {
  return pad(Math.min(99, Math.max(1, s.length)), 2);
}

const commands = [
  { label: "home",  href: "/" },
  { label: "blog",  href: "/blog" },
  { label: "tags",  href: "/tags" },
  { label: "about", href: "/about" },
];
---

<Layout title="">
  <section class="home">
    <div class="terminal-panel hero-terminal" data-motion="shell">
      <div class="terminal-titlebar">
        <span class="terminal-dots" aria-hidden="true">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
        </span>
        <span class="window-title">~/krismile.blog</span>
        <span class="window-meta">interactive shell</span>
      </div>

      <div class="hero-grid">
        <div class="hero-copy" data-motion="block">
          <div class="terminal-command"><span class="prompt">$</span> whoami</div>
          <h1>krismile · programmer</h1>
          <p>写代码、读书，也把那些短暂发亮的工程片段留下来。</p>

          <div class="hero-actions">
            <a href="/blog" class="primary-action" data-astro-prefetch data-motion="chip">open posts</a>
            <a href="/about" class="secondary-action" data-astro-prefetch data-motion="chip">cat about.txt</a>
          </div>
        </div>

        <div class="hero-console" data-motion="panel">
          <div class="terminal-command"><span class="prompt">$</span> status --short</div>
          <dl>
            <div>
              <dt>posts</dt>
              <dd>{total}</dd>
            </div>
            <div>
              <dt>latest</dt>
              <dd>{recent[0] ? fmtDate(recent[0].data.pubDate) : "empty"}</dd>
            </div>
            <div>
              <dt>signal</dt>
              <dd><span class="live-dot"></span> ready</dd>
            </div>
          </dl>
          <div class="clock">
            <span class="prompt">$</span> date
            <span id="clock-line">-</span>
          </div>
        </div>
      </div>
    </div>

    <div class="home-grid">
      <section class="terminal-panel recent-panel" data-motion="panel">
        <div class="terminal-titlebar">
          <span class="terminal-status"><strong>posts/</strong> sorted by time</span>
          <a href="/blog" data-astro-prefetch class="panel-link">view all</a>
        </div>
        <div class="post-table">
          <div class="post-row head">
            <span class="col-perm">mode</span>
            <span class="col-size">size</span>
            <span class="col-date">modified</span>
            <span class="col-name">name</span>
          </div>
          {recent.map((p) => (
            <a
              href={`/posts/${p.slug}`}
              class="post-row terminal-row"
              data-motion="row"
              data-motion-hover
              data-astro-prefetch
            >
              <span class="col-perm">-rw-r--r--</span>
              <span class="col-size">{size(p.data.title)}k</span>
              <span class="col-date">{fmtDate(p.data.pubDate)}</span>
              <span class="col-name">
                <span class="dot">›</span>
                {p.data.title}
                <span class="ext">.md</span>
              </span>
            </a>
          ))}
          {recent.length === 0 && (
            <div class="post-row empty">
              <span class="col-name muted">total 0 · 空荡的目录</span>
            </div>
          )}
        </div>
      </section>

      <aside class="side-stack">
        <section class="terminal-panel mini-panel" data-motion="block">
          <div class="terminal-command"><span class="prompt">$</span> cd</div>
          <div class="chips">
            {commands.map((c) => (
              <a class="chip terminal-chip" href={c.href} data-astro-prefetch data-motion="chip">{c.label}</a>
            ))}
          </div>
        </section>

        <section class="terminal-panel mini-panel quote-panel" data-motion="block">
          <div class="terminal-command"><span class="prompt">$</span> tail -f notes.log</div>
          <p>从具体问题里长出一点点秩序。</p>
          <div class="cursor-line"><span class="prompt">$</span><span class="term-cursor"></span></div>
        </section>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0.75rem 0 1.5rem;
  }

  .hero-terminal {
    min-height: clamp(30rem, 58vh, 42rem);
  }

  .window-title {
    color: var(--text-secondary);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .window-meta {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: 1rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    align-items: stretch;
  }

  .hero-copy {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    justify-content: center;
  }

  .prompt { color: var(--accent); margin-right: 0.5rem; user-select: none; }

  h1 {
    margin-top: 1rem;
    max-width: 11ch;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.98;
    font-weight: 700;
  }

  .hero-copy p {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-default);
    transition: transform 150ms ease, border-color 150ms ease, background 150ms ease, color 150ms ease;
  }

  .primary-action {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .primary-action:hover {
    color: var(--bg);
    background: var(--accent-soft);
  }

  .secondary-action {
    color: var(--text-secondary);
    background: rgba(var(--surface-rgb), 0.64);
  }

  .secondary-action:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }

  .hero-console {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 22rem;
    padding: 1rem;
    border-left: 1px dashed var(--border-default);
    background: linear-gradient(180deg, rgba(var(--elevated-rgb), 0.42), transparent);
  }

  .hero-console dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .hero-console dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px dashed var(--border-subtle);
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.125rem;
  }

  .live-dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: var(--green);
    box-shadow: 0 0 12px var(--green);
  }

  .clock {
    display: grid;
    gap: 0.375rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  #clock-line {
    color: var(--text-secondary);
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: 1.25rem;
  }

  .recent-panel {
    min-width: 0;
  }

  .panel-link {
    margin-left: auto;
    color: var(--accent);
    font-size: 0.8125rem;
    border-bottom: 1px dashed var(--accent-dim);
  }

  .panel-link:hover { border-bottom-style: solid; }

  .post-table {
    padding: 0.5rem 0;
  }

  .post-row {
    display: grid;
    grid-template-columns: 92px 36px 100px 1fr;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.875rem 1rem;
    color: var(--text-secondary);
    font-size: 0.9375rem;
  }
  .post-row.head {
    color: var(--text-faint);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0;
    border-bottom: 1px dashed var(--border-subtle);
    padding-bottom: 0.5rem;
  }
  a.post-row:hover .dot { color: var(--accent); }
  a.post-row:hover .col-name { color: var(--text-primary); }

  .col-perm { color: var(--text-muted); }
  .col-size { color: var(--text-faint); text-align: right; }
  .col-date { color: var(--text-muted); }
  .col-name { color: var(--text-secondary); }
  .col-name .dot { color: var(--text-faint); margin-right: 0.375rem; }
  .col-name .ext { color: var(--text-faint); }

  @media (max-width: 640px) {
    .post-row {
      grid-template-columns: 80px 1fr;
      grid-template-areas:
        "date name"
        "perm name";
      row-gap: 0.125rem;
    }
    .post-row.head { display: none; }
    .col-date { grid-area: date; }
    .col-name { grid-area: name; }
    .col-perm { grid-area: perm; font-size: 0.75rem; }
    .col-size { display: none; }
  }

  .side-stack {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .mini-panel {
    padding: 1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }
  .chip {
    padding: 0.375rem 0.875rem;
    font-size: 0.9375rem;
  }
  .chip::before {
    content: "[";
    color: var(--text-faint);
    margin-right: 0.125rem;
  }
  .chip::after {
    content: "]";
    color: var(--text-faint);
    margin-left: 0.125rem;
  }
  .chip:hover::before, .chip:hover::after { color: var(--accent-dim); }

  .quote-panel p {
    margin-top: 1rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .cursor-line {
    margin-top: 1rem;
    color: var(--text-primary);
  }

  .muted { color: var(--text-muted); }

  @media (max-width: 900px) {
    .hero-grid,
    .home-grid {
      grid-template-columns: 1fr;
    }

    .hero-console {
      min-height: auto;
      border-left: 0;
      border-top: 1px dashed var(--border-default);
    }
  }

  @media (max-width: 640px) {
    .hero-terminal {
      min-height: auto;
    }

    .hero-grid {
      padding: 1rem;
    }

    .hero-copy {
      min-height: 21rem;
    }

    h1 {
      font-size: clamp(2.75rem, 17vw, 4.25rem);
    }
  }
</style>

<script>
  function fmt() {
    const d = new Date();
    const pad = (n: number, w = 2) => n.toString().padStart(w, "0");
    const days = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
    const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    const tz = new Intl.DateTimeFormat("en-US", { timeZoneName: "short" })
      .formatToParts(d).find(p => p.type === "timeZoneName")?.value ?? "";
    return `${days[d.getDay()]} ${months[d.getMonth()]} ${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())} ${tz} ${d.getFullYear()}`;
  }
  function tick() {
    const el = document.getElementById("clock-line");
    if (el) el.textContent = fmt();
  }
  tick();
  setInterval(tick, 1000);
  document.addEventListener("astro:after-swap", tick);
</script>
